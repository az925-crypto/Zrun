<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- FITUR STRAVA: lokasi untuk merekam rute lari -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Foreground service tipe location agar rekaman lanjut di background (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:targetApi="34" />
    <!-- Notifikasi runtime (Android 13+) untuk notif rekaman & media -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Hanya berlaku di API 34+ (Android 14+), diabaikan di bawahnya -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:targetApi="34" />
    <!-- FIX: Permission untuk FloatingPlayerService foreground service type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <!-- FIX BUG #1: WAKE_LOCK untuk PARTIAL_WAKE_LOCK di ExoPlayer agar CPU
         tidak masuk power-saving mode saat layar mati → mencegah buffer habis -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Untuk floating bubble - user harus grant manual di Settings -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- FIX: RECORD_AUDIO untuk AudioVisualizerView.
         Tanpa permission ini, Visualizer(audioSessionId) selalu throw SecurityException
         → AudioVisualizerView jatuh ke FakeVisualizerView (animasi palsu).
         User akan diminta grant saat pertama kali membuka PlayerScreen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <application
        android:name=".ZmusicApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zmusic">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Zmusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- FIX BUG #8: foregroundServiceType="mediaPlayback" memastikan
             startForeground() yang kita panggil di onCreate() valid secara sistem.
             Tanpa ini, startForeground() di Android 10+ bisa throw exception. -->
        <service
            android:name=".service.MusicService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>

        <!-- FIX BUG #4: FloatingPlayerService dengan foregroundServiceType="specialUse"
             agar tidak di-kill oleh sistem di Android 12+ tanpa notifikasi foreground.
             Pakai specialUse karena ini overlay/floating UI, bukan media playback. -->
        <service
            android:name=".service.FloatingPlayerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_player_overlay" />
        </service>

        <!-- FITUR STRAVA: foreground service perekam GPS (tipe location) -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FITUR STRAVA: Google Maps API key (dari local.properties) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <receiver
            android:name=".widget.ZmusicWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.zaaam.Zmusic.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/zmusic_widget_info" />
        </receiver>

        <!-- FIX: FileProvider untuk NowPlayingCardGenerator.
             getUriForFile() butuh FileProvider agar bisa share bitmap ke app lain
             (WhatsApp, Instagram, dll) tanpa FileUriExposedException di Android 7+.
             authorities HARUS sama persis dengan di kode:
             "${context.packageName}.fileprovider" -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths"/>
        </provider>

    </application>

</manifest>
