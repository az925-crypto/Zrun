<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="68dp"
    android:layout_height="68dp"
    android:padding="4dp">

    <!-- Bubble container -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_floating_bubble"
        android:elevation="8dp">

        <!-- Album art thumbnail -->
        <ImageView
            android:id="@+id/imgBubbleThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_floating_bubble" />

        <!-- Dark overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#55000000" />

        <!-- Z logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Z"
            android:textColor="#FF5EB7F6"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <!-- Playing indicator dot (visible saat lagu playing) -->
        <View
            android:id="@+id/playingIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_playing_dot"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
