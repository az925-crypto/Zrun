# Salin file ini jadi `local.properties` lalu isi nilainya.
# `local.properties` di-ignore git, jadi key kamu tidak ikut ter-commit.

# Path Android SDK (Android Studio mengisi ini otomatis).
# sdk.dir=/Users/kamu/Library/Android/sdk

# FITUR STRAVA — Google Maps API key (wajib agar peta muncul).
# Buat di https://console.cloud.google.com/ → aktifkan "Maps SDK for Android".
MAPS_API_KEY=ISI_GOOGLE_MAPS_API_KEY_KAMU
